# SafeSight AI Environment Configuration
PROJECT_NAME="SafeSight AI"
VERSION="1.0.0-round3"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL/PostGIS, falls back to SQLite for local standalone run)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safesight_ai"
# Fallback SQLite DB path when PostgreSQL is unavailable
SQLITE_FALLBACK_URL="sqlite:///./safesight.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# Storage
STORAGE_ROOT="./storage"
EVIDENCE_EXPIRY_SECONDS=3600

# AI Models & Config
YOLO_MODEL_PATH="./yolov8n.pt"
YOLO_CONFIG_DIR="./.yolo"

# Auth / Security
JWT_SECRET_KEY="safesight-ai-round3-innovathon-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
